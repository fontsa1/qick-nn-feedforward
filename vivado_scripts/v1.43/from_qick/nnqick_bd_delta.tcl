#################################################################
# nnqick_bd_delta.tcl: turns QICK's qick_tprocv2_4x2_standard block design (openquantumhardware/qick commit 779dffa,
# firmware/projects/qick_tprocv2_4x2_standard/bd_2023-1.tcl) into the v1.43 block design of the paper.
#
# Generated by analysis_scripts/bd_delta/gen_delta.py from QICK's bd_2023-1.tcl and our write_bd_tcl export of v1.43
# (OG_build_v1.43_bd.tcl). Do not hand-edit; regenerate. Sourced by nnqick_from_qick.tcl, which opens the QICK
# project, adds our RTL and HLS cores, and calls nnqick_apply_delta on the open block design.
#
# Removed from QICK's design: axi_dma_tt, axis_register_slice_5, qick_time_tagger_0
# Added: NN_axi_0, NN_live_0, axi_bram_ctrl_0, axi_bram_ctrl_0_bram, axi_bram_ctrl_gate, axi_bram_ctrl_gate_bram, axi_bram_ctrl_live, axi_bram_ctrl_live_bram, axi_bram_ctrl_seg, axi_bram_ctrl_seg_bram, axis_broadcaster_clean, axis_data_fifo_clean, boxcar_tap_0, dac_gate_0, live_gate_0, live_rec_wreg_0, live_res_cdc_0, live_res_cdc_1, nn_axi_trigger_tieoff, rf_tap_0, seg_stamp_0, trig_sync_0
# QICK blocks reconfigured: /axi_smc, /axis_broadcaster_0, /clk_core, /ddr4/axis_buffer_ddr_0, /ps8_0_axi_periph, /qick_processor_0
#################################################################

proc nnq_disconnect_net {o} { set n [get_bd_nets -quiet -of_objects $o]; if {$n ne ""} { disconnect_bd_net $n $o } }
proc nnq_disconnect_intf {o} { set n [get_bd_intf_nets -quiet -of_objects $o]; if {$n ne ""} { disconnect_bd_intf_net $n $o } }

proc nnqick_apply_delta {} {
  current_bd_instance /
  if {[llength [get_bd_cells -quiet qick_processor_0]] != 1 || [llength [get_bd_cells -quiet NN_live_0]] != 0} {
    error "nnqick_apply_delta: the open block design is not an unmodified qick_tprocv2_4x2_standard design"
  }

  # ---- 1. QICK blocks this design does not use (time tagger and its DMA path)
  delete_bd_objs [get_bd_cells {axi_dma_tt axis_register_slice_5 qick_time_tagger_0}]

  # ---- 2. QICK blocks reconfigured
  # /ddr4/axis_buffer_ddr_0: DATA_WIDTH (default) -> {512}
  set_property -dict [list CONFIG.DATA_WIDTH {512}] [get_bd_cells /ddr4/axis_buffer_ddr_0]
  # /axi_smc: NUM_SI {7} -> {6}
  set_property -dict [list CONFIG.NUM_SI {6}] [get_bd_cells /axi_smc]
  # /axis_broadcaster_0: NUM_MI (default) -> {3}
  set_property -dict [list CONFIG.NUM_MI {3}] [get_bd_cells /axis_broadcaster_0]
  # /clk_core: CLKOUT1_JITTER {85.052} -> {186.982}, CLKOUT1_PHASE_ERROR {77.902} -> {353.086}, CLKOUT1_REQUESTED_OUT_FREQ {245.76} -> {200}, MMCM_CLKFBOUT_MULT_F {4.875} -> {78.125}, MMCM_CLKOUT0_DIVIDE_F {4.875} -> {6.000}, MMCM_DIVCLK_DIVIDE {2} -> {32}
  set_property -dict [list CONFIG.CLKOUT1_JITTER {186.982} CONFIG.CLKOUT1_PHASE_ERROR {353.086} CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {200} CONFIG.MMCM_CLKFBOUT_MULT_F {78.125} CONFIG.MMCM_CLKOUT0_DIVIDE_F {6.000} CONFIG.MMCM_DIVCLK_DIVIDE {32}] [get_bd_cells /clk_core]
  # /ps8_0_axi_periph: NUM_MI {22} -> {27}
  set_property -dict [list CONFIG.NUM_MI {27}] [get_bd_cells /ps8_0_axi_periph]
  # /qick_processor_0: IN_PORT_QTY {3} -> {4}
  set_property -dict [list CONFIG.IN_PORT_QTY {4}] [get_bd_cells /qick_processor_0]

  # ---- 3. added blocks (from the v1.43 export, unchanged)
  # Create instance: NN_axi_0, and set properties
  set NN_axi_0 [ create_bd_cell -type ip -vlnv xilinx.com:hls:NN_axi:1.41 NN_axi_0 ]

  # Create instance: NN_live_0, and set properties
  set NN_live_0 [ create_bd_cell -type ip -vlnv xilinx.com:hls:NN_live:1.5 NN_live_0 ]

  # Create instance: axi_bram_ctrl_0, and set properties
  set axi_bram_ctrl_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_bram_ctrl:4.1 axi_bram_ctrl_0 ]
  set_property -dict [list \
    CONFIG.PROTOCOL {AXI4LITE} \
    CONFIG.SINGLE_PORT_BRAM {1} \
  ] $axi_bram_ctrl_0

  # Create instance: axi_bram_ctrl_0_bram, and set properties
  set axi_bram_ctrl_0_bram [ create_bd_cell -type ip -vlnv xilinx.com:ip:blk_mem_gen:8.4 axi_bram_ctrl_0_bram ]
  set_property CONFIG.Memory_Type {True_Dual_Port_RAM} $axi_bram_ctrl_0_bram

  # Create instance: axi_bram_ctrl_gate, and set properties
  set axi_bram_ctrl_gate [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_bram_ctrl:4.1 axi_bram_ctrl_gate ]
  set_property -dict [list \
    CONFIG.PROTOCOL {AXI4LITE} \
    CONFIG.SINGLE_PORT_BRAM {1} \
  ] $axi_bram_ctrl_gate

  # Create instance: axi_bram_ctrl_gate_bram, and set properties
  set axi_bram_ctrl_gate_bram [ create_bd_cell -type ip -vlnv xilinx.com:ip:blk_mem_gen:8.4 axi_bram_ctrl_gate_bram ]
  set_property CONFIG.Memory_Type {True_Dual_Port_RAM} $axi_bram_ctrl_gate_bram

  # Create instance: axi_bram_ctrl_live, and set properties
  set axi_bram_ctrl_live [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_bram_ctrl:4.1 axi_bram_ctrl_live ]
  set_property -dict [list \
    CONFIG.PROTOCOL {AXI4LITE} \
    CONFIG.SINGLE_PORT_BRAM {1} \
  ] $axi_bram_ctrl_live

  # Create instance: axi_bram_ctrl_live_bram, and set properties
  set axi_bram_ctrl_live_bram [ create_bd_cell -type ip -vlnv xilinx.com:ip:blk_mem_gen:8.4 axi_bram_ctrl_live_bram ]
  set_property CONFIG.Memory_Type {True_Dual_Port_RAM} $axi_bram_ctrl_live_bram

  # Create instance: axi_bram_ctrl_seg, and set properties
  set axi_bram_ctrl_seg [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_bram_ctrl:4.1 axi_bram_ctrl_seg ]
  set_property -dict [list \
    CONFIG.PROTOCOL {AXI4LITE} \
    CONFIG.SINGLE_PORT_BRAM {1} \
  ] $axi_bram_ctrl_seg

  # Create instance: axi_bram_ctrl_seg_bram, and set properties
  set axi_bram_ctrl_seg_bram [ create_bd_cell -type ip -vlnv xilinx.com:ip:blk_mem_gen:8.4 axi_bram_ctrl_seg_bram ]
  set_property CONFIG.Memory_Type {True_Dual_Port_RAM} $axi_bram_ctrl_seg_bram

  # Create instance: axis_broadcaster_clean, and set properties
  set axis_broadcaster_clean [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_broadcaster:1.1 axis_broadcaster_clean ]
  set_property -dict [list \
    CONFIG.HAS_TREADY {1} \
    CONFIG.M_TDATA_NUM_BYTES {4} \
    CONFIG.NUM_MI {2} \
    CONFIG.S_TDATA_NUM_BYTES {4} \
  ] $axis_broadcaster_clean

  # Create instance: axis_data_fifo_clean, and set properties
  set axis_data_fifo_clean [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_data_fifo:2.0 axis_data_fifo_clean ]
  set_property -dict [list \
    CONFIG.FIFO_DEPTH {1024} \
    CONFIG.IS_ACLK_ASYNC {0} \
    CONFIG.TDATA_NUM_BYTES {4} \
  ] $axis_data_fifo_clean

  # Create instance: boxcar_tap_0, and set properties
  set block_name boxcar_tap
  set block_cell_name boxcar_tap_0
  if { [catch {set boxcar_tap_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $boxcar_tap_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: dac_gate_0, and set properties
  set block_name dac_gate
  set block_cell_name dac_gate_0
  if { [catch {set dac_gate_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $dac_gate_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
    set_property -dict [list \
    CONFIG.CFG_SAFE {0} \
    CONFIG.EARLY_BLANK {1} \
    CONFIG.FAIL_SAFE {1} \
    CONFIG.SHOT_BIND {1} \
  ] $dac_gate_0

  # Create instance: live_gate_0, and set properties
  set block_name live_window_gate
  set block_cell_name live_gate_0
  if { [catch {set live_gate_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $live_gate_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }
    set_property CONFIG.N {576} $live_gate_0

  # Create instance: live_rec_wreg_0, and set properties
  set block_name live_rec_wreg
  set block_cell_name live_rec_wreg_0
  if { [catch {set live_rec_wreg_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $live_rec_wreg_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: live_res_cdc_0, and set properties
  set block_name live_res_cdc
  set block_cell_name live_res_cdc_0
  if { [catch {set live_res_cdc_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $live_res_cdc_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: live_res_cdc_1, and set properties
  set block_name live_res_cdc
  set block_cell_name live_res_cdc_1
  if { [catch {set live_res_cdc_1 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $live_res_cdc_1 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: nn_axi_trigger_tieoff, and set properties
  set nn_axi_trigger_tieoff [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 nn_axi_trigger_tieoff ]
  set_property -dict [list \
    CONFIG.CONST_VAL {1} \
    CONFIG.CONST_WIDTH {1} \
  ] $nn_axi_trigger_tieoff

  # Create instance: rf_tap_0, and set properties
  set block_name rf_tap
  set block_cell_name rf_tap_0
  if { [catch {set rf_tap_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $rf_tap_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: seg_stamp_0, and set properties
  set block_name seg_stamp
  set block_cell_name seg_stamp_0
  if { [catch {set seg_stamp_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $seg_stamp_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # Create instance: trig_sync_0, and set properties
  set block_name trig_sync
  set block_cell_name trig_sync_0
  if { [catch {set trig_sync_0 [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   } elseif { $trig_sync_0 eq "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
     return 1
   }

  # ---- interface connections: 5 QICK intf_nets change, 30 intf_nets made
  nnq_disconnect_intf [get_bd_intf_pins /axis_avg_buffer_0/m1_axis]
  nnq_disconnect_intf [get_bd_intf_pins /axis_broadcaster_1/S_AXIS]
  nnq_disconnect_intf [get_bd_intf_pins /axis_dyn_readout_v1_0/m0_axis]
  nnq_disconnect_intf [get_bd_intf_pins /axis_dyn_readout_v1_1/m1_axis]
  nnq_disconnect_intf [get_bd_intf_pins /axis_register_slice_0/m_axis]
  nnq_disconnect_intf [get_bd_intf_pins /axis_register_slice_2/S_AXIS]
  nnq_disconnect_intf [get_bd_intf_pins /axis_switch_buf/S00_AXIS]
  nnq_disconnect_intf [get_bd_intf_pins /axis_switch_mr/S00_AXIS]
  nnq_disconnect_intf [get_bd_intf_pins /usp_rf_data_converter_0/m00_axis]
  nnq_disconnect_intf [get_bd_intf_pins /usp_rf_data_converter_0/s00_axis]
  connect_bd_intf_net [get_bd_intf_pins /NN_axi_0/in_r] [get_bd_intf_pins /axis_data_fifo_clean/M_AXIS]
  connect_bd_intf_net [get_bd_intf_pins /NN_axi_0/out_r_PORTA] [get_bd_intf_pins /axi_bram_ctrl_0_bram/BRAM_PORTB]
  connect_bd_intf_net [get_bd_intf_pins /NN_axi_0/s_axi_config] [get_bd_intf_pins /ps8_0_axi_periph/M22_AXI]
  connect_bd_intf_net [get_bd_intf_pins /NN_live_0/in_r] [get_bd_intf_pins /live_gate_0/m_axis]
  connect_bd_intf_net [get_bd_intf_pins /NN_live_0/out_r_PORTA] [get_bd_intf_pins /live_rec_wreg_0/s_bram]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_0/BRAM_PORTA] [get_bd_intf_pins /axi_bram_ctrl_0_bram/BRAM_PORTA]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_0/S_AXI] [get_bd_intf_pins /ps8_0_axi_periph/M23_AXI]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_gate/BRAM_PORTA] [get_bd_intf_pins /axi_bram_ctrl_gate_bram/BRAM_PORTA]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_gate/S_AXI] [get_bd_intf_pins /ps8_0_axi_periph/M26_AXI]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_gate_bram/BRAM_PORTB] [get_bd_intf_pins /dac_gate_0/BRAM_PORT]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_live/BRAM_PORTA] [get_bd_intf_pins /axi_bram_ctrl_live_bram/BRAM_PORTA]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_live/S_AXI] [get_bd_intf_pins /ps8_0_axi_periph/M24_AXI]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_live_bram/BRAM_PORTB] [get_bd_intf_pins /live_rec_wreg_0/m_bram]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_seg/BRAM_PORTA] [get_bd_intf_pins /axi_bram_ctrl_seg_bram/BRAM_PORTA]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_seg/S_AXI] [get_bd_intf_pins /ps8_0_axi_periph/M25_AXI]
  connect_bd_intf_net [get_bd_intf_pins /axi_bram_ctrl_seg_bram/BRAM_PORTB] [get_bd_intf_pins /seg_stamp_0/BRAM_PORT]
  connect_bd_intf_net [get_bd_intf_pins /axis_avg_buffer_0/m1_axis] [get_bd_intf_pins /axis_broadcaster_clean/S_AXIS]
  connect_bd_intf_net [get_bd_intf_pins /axis_broadcaster_0/M02_AXIS] [get_bd_intf_pins /boxcar_tap_0/s_fir]
  connect_bd_intf_net [get_bd_intf_pins /axis_broadcaster_1/S_AXIS] [get_bd_intf_pins /boxcar_tap_0/m_box_axis]
  connect_bd_intf_net [get_bd_intf_pins /axis_broadcaster_clean/M00_AXIS] [get_bd_intf_pins /axis_switch_buf/S00_AXIS]
  connect_bd_intf_net [get_bd_intf_pins /axis_broadcaster_clean/M01_AXIS] [get_bd_intf_pins /axis_data_fifo_clean/S_AXIS]
  connect_bd_intf_net [get_bd_intf_pins /axis_dyn_readout_v1_0/m0_axis] [get_bd_intf_pins /boxcar_tap_0/s_axis]
  connect_bd_intf_net [get_bd_intf_pins /axis_register_slice_0/m_axis] [get_bd_intf_pins /dac_gate_0/s_axis]
  connect_bd_intf_net [get_bd_intf_pins /axis_register_slice_2/S_AXIS] [get_bd_intf_pins /rf_tap_0/m_axis]
  connect_bd_intf_net [get_bd_intf_pins /axis_switch_mr/S00_AXIS] [get_bd_intf_pins /boxcar_tap_0/m_mr_axis]
  connect_bd_intf_net [get_bd_intf_pins /boxcar_tap_0/m_nn] [get_bd_intf_pins /live_gate_0/s_axis]
  connect_bd_intf_net [get_bd_intf_pins /dac_gate_0/dec_axis] [get_bd_intf_pins /live_res_cdc_1/m_axis]
  connect_bd_intf_net [get_bd_intf_pins /dac_gate_0/m_axis] [get_bd_intf_pins /usp_rf_data_converter_0/s00_axis]
  connect_bd_intf_net [get_bd_intf_pins /live_res_cdc_0/m_axis] [get_bd_intf_pins /qick_processor_0/s3_axis]
  connect_bd_intf_net [get_bd_intf_pins /rf_tap_0/s_axis] [get_bd_intf_pins /usp_rf_data_converter_0/m00_axis]
  # ---- port connections: 11 QICK nets change, 22 nets made
  nnq_disconnect_net [get_bd_ports /PMOD0_6]
  nnq_disconnect_net [get_bd_ports /PMOD0_7]
  nnq_disconnect_net [get_bd_pins /axi_dma_avg/axi_resetn]
  nnq_disconnect_net [get_bd_pins /axi_dma_avg/m_axi_s2mm_aclk]
  nnq_disconnect_net [get_bd_pins /axi_dma_avg/s_axi_lite_aclk]
  nnq_disconnect_net [get_bd_pins /axi_dma_buf/axi_resetn]
  nnq_disconnect_net [get_bd_pins /axi_dma_buf/m_axi_s2mm_aclk]
  nnq_disconnect_net [get_bd_pins /axi_dma_buf/s_axi_lite_aclk]
