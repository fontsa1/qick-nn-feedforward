# HLS project settings for NN_live 1.5, the streaming classifier on the boxcar readout path (576-sample window).
variable project_name
set project_name "NN_live"
variable part
set part "xczu48dr-ffvg1517-2-e"
# Runs on clk_adc0_x2 beside axis_dyn_readout_v1_0: 552.96 MHz.
variable clock_period
set clock_period 1.808
variable clock_uncertainty
set clock_uncertainty 12.5%
variable version
set version "1.5"
